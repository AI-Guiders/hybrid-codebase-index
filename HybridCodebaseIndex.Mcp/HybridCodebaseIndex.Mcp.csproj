<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HybridCodebaseIndex.Mcp</RootNamespace>
    <AssemblyName>HybridCodebaseIndex.Mcp</AssemblyName>

    <VersionPrefix>0.1.0</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="HybridCodebaseIndex.Mcp.Tests\**\*.cs" />
    <None Remove="HybridCodebaseIndex.Mcp.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HybridCodebaseIndex.Mcp.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ExportMcpManifest</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.8.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HybridCodebaseIndex.Core\HybridCodebaseIndex.Core.csproj" />
  </ItemGroup>

  <!-- sqlite-vec loadable extension (Windows x64). Omitted on machines where the file is not present (e.g. Linux CI). -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\native\win-x64\vec0.dll')">
    <None Include="native\win-x64\vec0.dll" CopyToOutputDirectory="PreserveNewest" Link="vec0.dll" />
  </ItemGroup>

  <!-- sqlite-vec loadable extension (Linux x64). -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\native\linux-x64\vec0.so')">
    <None Include="native\linux-x64\vec0.so" CopyToOutputDirectory="PreserveNewest" Link="vec0.so" />
  </ItemGroup>

  <!-- sqlite-vec loadable extension (macOS x64). -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\native\osx-x64\vec0.dylib')">
    <None Include="native\osx-x64\vec0.dylib" CopyToOutputDirectory="PreserveNewest" Link="vec0.dylib" />
  </ItemGroup>
</Project>
